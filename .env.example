# ---------------------------------------------------------------------------
# LLM  (pick ONE provider; research-swarm auto-detects whichever key is set)
# ---------------------------------------------------------------------------
# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting: gemini | openai | anthropic | mock
LLM_PROVIDER=
# Model id per provider (sensible defaults are built in).
GEMINI_MODEL=gemini-3.8-flash
# Optional: 0 disables Gemini's internal thinking (measurably faster on
# well-specified extraction tasks). Empty = provider default.
GEMINI_THINKING_BUDGET=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Web search / source discovery  (pick ONE; optional if you use mock mode)
# ---------------------------------------------------------------------------
# Exa is purpose-built for AI agent grounding and has a free tier:
#   https://dashboard.exa.ai  -> API Keys
EXA_API_KEY=
# Tavily: https://app.tavily.com
TAVILY_API_KEY=
# SerpAPI: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Force a search provider instead of auto-detecting:
#   tavily | exa | serpapi | gemini | mock
SEARCH_PROVIDER=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
RESEARCH_MAX_SUBQUESTIONS=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_CONCURRENCY=5
RESEARCH_MAX_CONTENT_CHARS=6000
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_CACHE_DIR=.cache
